@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SensorEventProtocol {

	// 1. Событие климатического датчика
	record ClimateSensorAvro {
		int temperature_c;
		int humidity;
		int co2_level;
	}

	// 2. Событие датчика освещенности
	record LightSensorAvro {
		int link_quality;
		int luminosity;
	}

	// 3. Событие датчика движения
	record MotionSensorAvro {
		int link_quality;
		boolean motion;
		int voltage;
	}

	// 4. Событие умного переключателя / розетки
	record SwitchSensorAvro {
		boolean state;
	}

	// 5. Событие датчика температуры
	record TemperatureSensorAvro {
		string id;
		string hubId;
		timestamp_ms timestamp;
		int temperature_c;
		int temperature_f;
	}

	// Главная обёртка для всех событий датчиков
	record SensorEventAvro {
		string id;
		string hubId;
		timestamp_ms timestamp;
		union {
			ClimateSensorAvro,
			LightSensorAvro,
			MotionSensorAvro,
			SwitchSensorAvro,
			TemperatureSensorAvro
		} payload;
	}
}